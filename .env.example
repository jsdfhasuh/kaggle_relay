# Required for legacy mode. Leave empty when RELAY_AUTH_CONFIG is used.
RELAY_API_TOKEN=
# Optional multi-token/multi-key config. If set, RELAY_API_TOKEN is not required.
# RELAY_AUTH_CONFIG=/data/auth.json
# Optional dedicated management key for RELAY_AUTH_CONFIG (minimum 8 characters).
# RELAY_ADMIN_TOKEN=change-me-custom-management-key
RELAY_STORAGE_DIR=/data
RELAY_CHUNK_SIZE=67108864
RELAY_RETENTION_HOURS=72
# Number of jobs the single Relay process may execute concurrently.
RELAY_WORKER_COUNT=2
# Public browser origin used for CSRF checks behind a TLS-terminating proxy.
# RELAY_PUBLIC_ORIGIN=https://relay.example.com
# Trust X-Forwarded-For only from these immediate proxy IPs (comma-separated).
# RELAY_TRUSTED_PROXY_IPS=127.0.0.1,::1
# Plain-HTTP local development uses false. Production HTTPS must set this true.
RELAY_UI_COOKIE_SECURE=false
# Failed authentication attempts are limited independently for UI, API, and callbacks.
RELAY_AUTH_FAILURE_LIMIT=10
RELAY_AUTH_FAILURE_WINDOW_SECONDS=60
RELAY_AUTH_LOCKOUT_SECONDS=300
# Optional stable UI cookie signing secret. RELAY_ADMIN_TOKEN is used when configured.
# RELAY_UI_SESSION_SECRET=

# Legacy single-key Kaggle credentials. Ignored for jobs bound to RELAY_AUTH_CONFIG keys.
# Either provide KAGGLE_API_TOKEN, KAGGLE_USERNAME/KAGGLE_KEY, or mount /root/.kaggle.
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_API_TOKEN=
